# 本地 Embedding（embedding_server.py）：sentence-transformers 模型目录，勿提交仓库
# EMBED_MODEL_LOCAL_PATH=C:\path\to\bge-m3

# QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:v1.17.1

QDRANT_IMAGE=qdrant/qdrant:v1.17.1

# Embedding: enterprise internal API (PRD §12.5). Worker calls this from server only; match vector dim to Qdrant collection.
# OpenAI-compatible clients: base URL usually ends with /v1 (then /embeddings relative to that).
# EMBEDDING_API_BASE_URL=http://localhost:8902/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=your-model-id
# EMBEDDING_VECTOR_DIM=1024
# EMBEDDING_TIMEOUT_SECONDS=60

# Admin "Open Qdrant Dashboard" button (PRD §5.2.2). Browser must reach this URL; use host port or reverse-proxy HTTPS.
# QDRANT_DASHBOARD_PUBLIC_URL=http://localhost:6333/dashboard

# vLLM OpenAI-compatible API for RAG polish (G8 / PRD §12.4). Do not commit secrets.
# VLLM_BASE_URL=http://localhost:8901/v1
# VLLM_API_KEY=
# VLLM_MODEL=Qwen3-30B-Thinking
# VLLM_TIMEOUT_SECONDS=120

# --- PRD §5.5 / §6 调度（node-cron，默认本机时区；可用 KB_CRON_TZ=Asia/Shanghai）---
# KB_DISABLE_SCHEDULER=1
# KB_DISABLE_NIGHT_BATCH=1
# KB_NIGHT_BATCH_CRON=0 1 * * *
# KB_ORPHAN_SCROLL_MAX_POINTS=8000
# KB_NIGHT_RECONCILE_DELETED_MAX=80
# KB_NIGHT_SKIP_ORPHAN=1
# KB_DISABLE_EHR_CRON=1
# KB_EHR_CRON=0 2 * * *
# KB_CRON_TZ=Asia/Shanghai
# DELETE_POLLER_MS=3000
# DISABLE_DELETE_POLLER=1
# KB_ENSURE_PAYLOAD_INDEX_ON_BOOT=1
# KB_SKIP_PAYLOAD_INDEX=1

# 审计采样：检索与 RAG（未设置时 RAG 与 search.query 共用 AUDIT_SEARCH_SAMPLE_RATE）
# AUDIT_SEARCH_SAMPLE_RATE=1
# AUDIT_RAG_SAMPLE_RATE=0.2

# 登录防暴力（无 REDIS_URL 时进程内按 IP；设置 REDIS_URL 后与检索限流共享 Redis，多实例一致）
# LOGIN_RATE_LIMIT_ENABLED=1
# LOGIN_MAX_FAILS_PER_IP=8
# LOGIN_LOCKOUT_MS=900000

# 鉴权后 API 限流（PRD §5.9）：DB API Key 按 keyId；否则按 IP；多实例请用网关
# API_RATE_LIMIT_ENABLED=1
# API_SEARCH_WINDOW_MS=60000
# API_SEARCH_MAX_PER_WINDOW=120
# API_DOC_WRITE_WINDOW_MS=60000
# API_DOC_WRITE_MAX_PER_WINDOW=40

# 多实例时限流 + 登录计数走 Redis（backend 自动探测）
# 本机：REDIS_URL=redis://127.0.0.1:6379
# docker compose --profile app --profile redis：在 .env 中设 REDIS_URL=redis://redis:6379
# 仅起 kb-api 不起 redis 时勿设 REDIS_URL，或留空，否则会连不上 Redis

# 向量模型版本写入 Qdrant payload（默认同 EMBEDDING_MODEL@EMBEDDING_VECTOR_DIM）
# EMBEDDING_MODEL_VERSION=bge-m3@1024

# 可选关键词 Rerank（无 Cross-Encoder，仅 text_preview 命中加权）
# SEARCH_RERANK_ENABLED=1

# 管理员检索是否跳过部门过滤（默认关闭；请优先用 POST /api/v1/admin/search 审计检索）
# SEARCH_ADMIN_BYPASS_ACL=0

# Excel：默认跳过工作簿中隐藏 Sheet（0=仍索引隐藏表）
# XLSX_SKIP_HIDDEN_SHEETS=1

# EHR 同步 source=rest 时拉取 JSON 员工列表（数组或 { employees|rows|data|items: [] }）
# EHR_SYNC_SOURCE=rest
# EHR_REST_URL=https://ehr.example.com/api/employees
# EHR_REST_BEARER_TOKEN=

# --- 镜像入库（管理端「同步配置」中「目标目录」优先；未配置表项时用 KB_SYNC_MIRROR_DIR）---
# KB_SYNC_MIRROR_DIR=<同步镜像根目录，按需填写>
# MIRROR_SCAN_MS=60000
# MIRROR_SCAN_MAX_FILES_PER_TICK=80
# DISABLE_MIRROR_SCAN=1
# KB_SYNC_DEFAULT_DEPT_IDS=[101]
# 定时镜像同步（node-cron）：KB_DISABLE_FOLDER_SYNC_CRON=1 可关
# KB_FOLDER_SYNC_WECOM_WEBHOOK=
# WECOM_WEBHOOK_URL=

# ----- 开源版 / 开发常用（勿提交真实口令）-----
# backend：开发兜底登录（仅当库中无匹配用户且配置了非空口令时生效）；不设则不启用该兜底
# DEV_LOGIN_ID=admin
# DEV_PASSWORD=
# DEV_USER_DEPT_IDS=101
#
# EHR 同步新建用户的初始口令（必填方可写入用户；生产请用强口令并通过首次登录改密闭环）
# DEV_DEFAULT_USER_PASSWORD=
#
# 模拟上传脚本 backend/scripts/simulate-*.mjs
# KB_TEST_PASSWORD=
#
# upsert-admin-user.cjs
# DEV_PASSWORD=
